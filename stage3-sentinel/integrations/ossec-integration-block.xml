<!--
  Add to /var/ossec/etc/ossec.conf on the Wazuh manager, then restart wazuh-manager.

  The name is the launcher (custom-sentinel), not the .py file. Wazuh runs
  integrations through a launcher; pointing it at the .py directly fails with
  "file has write permissions". Create the launcher by copying a built-in one:
    sudo cp -p /var/ossec/integrations/slack /var/ossec/integrations/custom-sentinel
  It starts custom-sentinel.py with Wazuh's bundled Python.
-->
<ossec_config>
  <integration>
    <name>custom-sentinel</name>
    <level>7</level>
    <alert_format>json</alert_format>
  </integration>
</ossec_config>
