    <field name="event_type">^NEW_CONNECTION$</field>
    <description>Conpot Kamstrup management: connection attempt from $(src_ip) on port $(dst_port)</description>
    <mitre>
      <id>T0846</id>
    </mitre>
    <group>conpot,kamstrup_management,connection_attempt,</group>
  </rule>

  <!--
    Rule ID:      100061
    Purpose:      Connection to the management interface closed. Pairs with 100060.
    Author:       Mohammed Aadil Khan
    Date:         2026-10-01 (built), 2026-10-02 (header rewritten)
    Log Source:   conpot_kamstrup_382.json, data_type kamstrup_management_protocol
    MITRE ATT&CK: ICS T0846 Remote System Discovery
    False Positive Matrix: none.
  -->
  <rule id="100061" level="3">
    <if_sid>86600</if_sid>
    <field name="data_type">^kamstrup_management_protocol$</field>
    <field name="event_type">^CONNECTION_LOST$</field>
    <description>Conpot Kamstrup management: connection from $(src_ip) lost</description>
    <mitre>
      <id>T0846</id>
    </mitre>
    <group>conpot,kamstrup_management,connection_lost,</group>
  </rule>

  <!--
    Rule ID:      100062
    Purpose:      Real data sent to the management interface. Live captures
                  include an HTTP GET probe and a PING style command, so someone
                  is talking to the device, not just scanning the port.
    Author:       Mohammed Aadil Khan
    Date:         2026-10-01 (built), 2026-10-02 (header rewritten)
    Log Source:   conpot_kamstrup_382.json, data_type kamstrup_management_protocol,
                  request not null
    MITRE ATT&CK: ICS T0888 Remote System Information Discovery.
                  Switch to T0836 Modify Parameter if a captured request turns
                  out to be a write or control command rather than a read.
    False Positive Matrix:
      A near-empty probe (just \r\n) still fires because it is not the literal
      "null". I am fine with that, it is still a client sending data.
  -->
  <rule id="100062" level="8">
    <if_sid>86600</if_sid>
    <field name="data_type">^kamstrup_management_protocol$</field>
    <field name="request" type="pcre2" negate="yes">^null$</field>
    <description>Conpot Kamstrup management: data sent from $(src_ip), possible recon or exploitation, request: $(request)</description>
    <mitre>
      <id>T0888</id>
    </mitre>
    <group>conpot,kamstrup_management,protocol_interaction,</group>
  </rule>

  <!--
    Rule ID:      100063
    Purpose:      New connection to the Kamstrup METER interface, the plain
                  meter reading protocol. Separate from the management side.
    Author:       Mohammed Aadil Khan
