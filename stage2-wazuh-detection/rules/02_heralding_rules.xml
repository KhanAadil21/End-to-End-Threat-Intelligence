<!--
  Kept in its own wrapper on purpose. The wrapper name becomes a group on the
  rule, and if it were called "heralding" this rule would count its own alerts.
-->
<group name="heralding_correlation,">

  <!--
    Rule ID:      100029
    Purpose:      One source_ip sets off any Heralding rule 5 times in 30
                  seconds. Counts across all eight services, so it catches a
                  bot sweeping several ports as well as one hammering a single
                  service. Level 10 sits above the per-port rules (5 to 8).
    Author:       Mohammed Aadil Khan
    Date:         2026-10-03
    Log Source:   Built on any rule in the heralding group (if_matched_group)
    MITRE ATT&CK: T1110 Brute Force (Credential Access)
    False Positive Matrix:
      It counts sessions, not submitted passwords. A scanner that connects
      and drops five times inside 30 seconds will trip it without ever
      sending a credential. Read the auth_attempts field before calling it a
      password attack.
  -->
  <rule id="100029" level="10" frequency="5" timeframe="30">
    <if_matched_group>heralding</if_matched_group>
    <same_field>source_ip</same_field>
    <description>Heralding honeypot: 5+ sessions in 30s from $(source_ip), likely brute force or service sweep</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>heralding_brute_force,</group>
  </rule>

</group>
