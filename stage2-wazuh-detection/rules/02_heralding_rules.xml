<!--
================================================================================
  HERALDING MULTI-PROTOCOL CREDENTIAL HONEYPOT: CUSTOM DETECTION RULES
  Rule ID range:   100021-100029
  Decoder:         none, generic JSON decoder (decoded_as json)
  Log source:      /home/tpotadmin/tpotce/data/heralding/log/log_session.json
                   One line per session: source_ip, destination_port, protocol,
                   num_auth_attempts, auth_attempts and so on.
  Author:          Mohammed Aadil Khan
  Project:         T-Pot/Vultr Honeypot Threat Intel Project, Stage 2

  Build notes
  - Heralding has no eventid, and its service field is called "protocol",
    which is one of Wazuh's 13 reserved static field names. I tried three
    ways to match on it (field tag, static tag, a child decoder that renamed
    it). Each one hit a Wazuh parsing bug or wiped the other decoded fields.
  - What works: match on destination_port instead. Every Heralding service
    has a fixed port, and Dionaea writes dst_port, so the two honeypots
    cannot collide on these rules.
  - An earlier catch-all rule matched the raw text "protocol": and ended up
    firing on Dionaea SMB logs too. Lesson kept: scope every match to
    something only this source writes.
  - auth_attempts is a JSON array of objects. The decoder flattens it into
    one string, so individual usernames cannot be matched as fields.
================================================================================
-->

<group name="heralding_services,">

  <!--
    Rule ID:      100021
    Purpose:      Session against Heralding's VNC listener. Highest of the port
                  rules because a working VNC login hands over a live desktop.
    Author:       Mohammed Aadil Khan
    Date:         2026-10-03
    Log Source:   log_session.json, destination_port 5900
    MITRE ATT&CK: T1110 Brute Force, T1021.005 Remote Services: VNC
    False Positive Matrix:
      Most VNC sessions I captured carry null credentials, meaning a scanner
      fingerprinting the port. Still unsolicited, so still logged.
  -->
  <rule id="100021" level="8">
    <decoded_as>json</decoded_as>
    <field name="destination_port">^5900$</field>
    <description>Heralding honeypot: VNC session from $(source_ip) on port $(destination_port)</description>
    <mitre>
      <id>T1110</id>
      <id>T1021.005</id>
    </mitre>
    <group>heralding,vnc,connection_attempt,</group>
  </rule>

  <!--
    Rule ID:      100022
    Purpose:      Session against the SMTPS listener (implicit TLS mail
                  submission). Stolen mail logins get reused for spam and
                  phishing relay, hence level 7.
    Author:       Mohammed Aadil Khan
    Date:         2026-10-03
    Log Source:   log_session.json, destination_port 465
    MITRE ATT&CK: T1110 Brute Force
    False Positive Matrix: none, there is no real mail service on this host.
  -->
  <rule id="100022" level="7">
    <decoded_as>json</decoded_as>
    <field name="destination_port">^465$</field>
    <description>Heralding honeypot: SMTPS session from $(source_ip) on port $(destination_port)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>heralding,smtps,connection_attempt,</group>
  </rule>

  <!--
    Rule ID:      100023
    Purpose:      Session against the POP3 listener. One step below SMTPS since
                  POP3 only reads a mailbox, it cannot send.
    Author:       Mohammed Aadil Khan
    Date:         2026-10-03
    Log Source:   log_session.json, destination_port 110
    MITRE ATT&CK: T1110 Brute Force
                  (T1114.002 Remote Email Collection would fit a successful
